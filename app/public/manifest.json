{
  "id": "4ffeeef6-21be-405f-a187-93d4faface0d",
  "name": "TV Thing",
  "version": "3.0.0",
  "description": "A tiny TV for your Car Thing. Picture on the Car Thing, sound on your computer. Add channels in settings.",
  "icon": "icon.svg",
  "permissions": ["net.fetch", "audio"],
  "overlays": { "volume": false },
  "settings": "settings.html",
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": ["net", "read", "write", "env", "run:/bin/sh", "run:/usr/bin/pkill"],
    "api": 1
  }
}
